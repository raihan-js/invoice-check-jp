<style>
*{box-sizing:border-box}
html,body{margin:0;background:{{skin.paper}};color:{{skin.ink}};font-family:{{skin.font}};font-size:{{skin.size}}px;line-height:1.5}
.page{width:794px;height:1123px;padding:46px 54px;position:relative;overflow:hidden;background:{{skin.paper}}}
table{border-collapse:collapse;width:100%}
.items th{background:{{skin.head_bg}};border:{{skin.rule}};padding:6px 8px;font-weight:700}
.items td{border:{{skin.rule}};padding:6px 8px}
